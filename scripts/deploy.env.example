# Settings for scripts/deploy.sh. Copy to .env.deploy (ignored by git), edit, then:
#   set -a; source .env.deploy; set +a
#   ./scripts/deploy.sh "$ALERT_EMAIL" "$BEDROCK_MODEL_ID"
# Keep the same switches on every deploy: a switch left out removes that feature's resources.
# Full instructions: docs/SETUP_AND_DEPLOYMENT.md

ALERT_EMAIL=you@example.org
BEDROCK_MODEL_ID=                 # model or inference-profile ID you tested (guide section 3.3)
OFFICER_TOKEN=change-me           # shared secret for plan approval while Cognito is off
ALERT_MIN_LEVEL=orange            # daily alerts go out at this level and above

ENABLE_LOCATION_MAP=0             # B: Amazon Location basemap + walking routes
ENABLE_KNOWLEDGE_BASE=0           # F: Bedrock Knowledge Base on S3 Vectors
KB_MIN_SCORE=0.4                  #    relevance floor for retrieved passages
ENABLE_TRANSLATE=1                # H: Amazon Translate (six regional languages)
SES_FROM_EMAIL=                   # I: sender address for SES HTML alerts (empty = SNS plain text)
ENABLE_COGNITO=0                  # K: Cognito sign-in for ward officers and city planners
ENABLE_LIVE_UPDATES=0             # L: WebSocket API for the Field Reports page
ENABLE_IOT_SENSORS=0              # G: AWS IoT Core street sensors
ENABLE_ANALYTICS=0                # J: Glue tables + Athena workgroup (QuickSight connects by hand)
ENABLE_WAF=0                      # M: AWS WAF, API served through CloudFront (about 8 USD a month)
